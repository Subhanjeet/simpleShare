# Supabase Credentials
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# App Room Limits
NEXT_PUBLIC_MAX_FILES_PER_ROOM=10
NEXT_PUBLIC_MAX_FILE_SIZE_MB=200
NEXT_PUBLIC_MAX_TOTAL_SIZE_MB=500

# Base URL for QR links
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cron Secret for automated cleanup API endpoint
CRON_SECRET=simpleshare-cron-secret-key-123
